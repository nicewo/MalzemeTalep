@model Material
<div class="page-head"><div><p class="eyebrow">KATALOG KAYDI</p><h1>@(Model.Id == 0 ? "Malzeme ekle" : "Malzemeyi düzenle")</h1></div><a href="/Materials" class="btn secondary">← Kataloğa dön</a></div>
<form asp-action="Save" method="post" class="panel form-grid"><input asp-for="Id" type="hidden"/><label>Marka<input asp-for="Brand" placeholder="Siemens, WAGO, SICK..." /></label><label>Kategori<input asp-for="Category" placeholder="İnverter, sensör, klemens..." /></label><label>Model / ürün kodu *<input asp-for="ModelCode" required /></label><label>Birim<input asp-for="Unit" /></label><label class="wide">Açıklama *<input asp-for="Description" required placeholder="Örn. 2,2 kW inverter" /></label><label class="wide">Teknik özellikler<textarea asp-for="TechnicalSpecs" rows="3" placeholder="Gerilim, akım, ölçü, bağlantı..." ></textarea></label><div class="wide actions"><button class="btn">Kaydet</button>@if (Model.Id != 0) { <button class="btn danger" type="submit" formaction="/Materials/Delete/@Model.Id" formmethod="post" formnovalidate>Sil</button> }</div></form>
