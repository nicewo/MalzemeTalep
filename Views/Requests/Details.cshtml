@model MaterialRequest
<div class="page-head"><div><p class="eyebrow">TALEP #@Model.Id</p><h1>@Model.Title</h1><p>@(Model.ProjectRecord?.Name ?? "Proje belirtilmedi") · @Model.RequestDate.ToString("dd.MM.yyyy")</p></div><div class="actions"><a class="btn secondary" href="/Requests/Pdf/@Model.Id?style=corporate">Kurumsal PDF</a><a class="btn" href="/Requests/Pdf/@Model.Id?style=modern">Modern PDF</a></div></div>
<div class="panel add-row"><form method="post" action="/Requests/AddItem">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@Model.Id"/><label>Malzeme<select name="materialId" required>@foreach (Material m in ViewBag.Materials) { <option value="@m.Id">@m.Brand · @m.ModelCode · @m.Description</option> }</select></label><label class="qty">Miktar<input name="quantity" type="number" min="0.001" step="0.001" value="1" required /></label><button class="btn">+ Listeye ekle</button></form></div>
<div class="panel"><table><thead><tr><th>#</th><th>Marka</th><th>Ürün kodu</th><th>Açıklama</th><th>Miktar</th><th>Birim</th><th></th></tr></thead><tbody>@{ var n=0; }@foreach (var item in Model.Items) { n++; <tr><td>@n</td><td>@item.BrandSnapshot</td><td><strong>@item.ModelCodeSnapshot</strong></td><td>@item.DescriptionSnapshot<small>@item.SpecsSnapshot</small></td><td>@item.Quantity</td><td>@item.UnitSnapshot</td><td><form method="post" action="/Requests/RemoveItem">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@Model.Id"/><input type="hidden" name="itemId" value="@item.Id"/><button class="link-danger">Kaldır</button></form></td></tr> } @if (!Model.Items.Any()) { <tr><td colspan="7" class="empty">Katalogdan ilk malzemeyi ekleyin.</td></tr> }</tbody></table></div>
