@model MaterialRequest
<div class="page-head"><div><p class="eyebrow">YENİ KAYIT</p><h1>Malzeme talebi oluştur</h1><p>Önce talebin başlığını ve bağlı olduğu projeyi belirleyin.</p></div></div>
<form method="post" class="panel form-grid">@Html.AntiForgeryToken()<label class="wide">Talep / liste adı *<input asp-for="Title" required placeholder="Örn. 6.CADDE 2. KURUTMA" /></label><label>Proje<select asp-for="ProjectRecordId"><option value="">Proje seçilmedi</option>@foreach (ProjectRecord p in ViewBag.Projects) { <option value="@p.Id">@p.Name</option> }</select></label><label>Tarih<input asp-for="RequestDate" type="date" value="@Model.RequestDate.ToString("yyyy-MM-dd")" /></label><label class="wide">Notlar<textarea asp-for="Notes" rows="2"></textarea></label><div class="wide"><button class="btn">Talebi oluştur ve malzeme ekle →</button></div></form>
